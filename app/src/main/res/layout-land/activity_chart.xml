<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".ChartActivity">

    <!-- 第一行：返回 + 币种 + 价格 + 涨跌 + 24h 高低量 + 设置 (高度固定 36dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="BTC-USDT" />

        <ImageView
            android:id="@+id/btnStar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:padding="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_watch"
            android:src="@drawable/ic_star_border" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/up"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="67,231.50" />

        <TextView
            android:id="@+id/tvChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/up"
            android:textSize="11sp"
            tools:text="+2.35%" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="高 68,000" />

        <TextView
            android:id="@+id/tvLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="低 65,200" />

        <TextView
            android:id="@+id/tvVol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="24h额 12.3亿" />

        <ImageButton
            android:id="@+id/btnChartSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- 第二行：周期切换条（或自适应折叠下拉框） + MA 图例 / 十字光标详情 (高度固定 28dp) -->
    <LinearLayout
        android:id="@+id/layoutBarContainer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <HorizontalScrollView
            android:id="@+id/scrollTimeframe"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgTimeframe"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton style="@style/TfButton" android:id="@+id/tf1m" android:text="@string/timeframe_1min" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf5m" android:text="@string/timeframe_5m" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf15m" android:text="@string/timeframe_15m" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf30m" android:text="@string/timeframe_30m" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf1h" android:text="@string/timeframe_1h" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf4h" android:text="@string/timeframe_4h" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf1d" android:text="@string/timeframe_1d" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf1w" android:text="@string/timeframe_1w" />
                <RadioButton style="@style/TfButton" android:id="@+id/tf1M" android:text="@string/timeframe_1m" />
            </RadioGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnTimeframeDropdown"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:textColor="@color/brand"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="15分 ▾" />

        <!-- 指标控制栏与光标详情叠放 -->
        <FrameLayout
            android:id="@+id/layoutRightFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">

            <LinearLayout
                android:id="@+id/layoutIndicators"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 主图指标 -->
                <TextView
                    android:id="@+id/tvMa1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="MA5"
                    android:textColor="@color/ma5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMa2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="MA10"
                    android:textColor="@color/ma10"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMa3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="MA20"
                    android:textColor="@color/ma20"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEma"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="EMA"
                    android:textColor="#06B6D4"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBoll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="BOLL"
                    android:textColor="@color/boll_up"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/vIndicatorDivider"
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/border" />

                <!-- 副图指标 -->
                <TextView
                    android:id="@+id/tvVolInd"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="VOL"
                    android:textColor="@color/text_main"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMacd"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="MACD"
                    android:textColor="@color/text_main"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvRsi"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="RSI"
                    android:textColor="@color/text_main"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvKdj"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="KDJ"
                    android:textColor="@color/text_main"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 弹性空白占位，将 MORE 与设置齿轮推至右侧 -->
                <View
                    android:id="@+id/vIndicatorSpace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvMoreIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp"
                    android:paddingEnd="5dp"
                    android:text="MORE ▾"
                    android:textColor="@color/brand"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- 最右侧设置齿轮按钮 -->
                <ImageButton
                    android:id="@+id/btnIndicatorSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="指标参数设置"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOhlcv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@color/bg"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:visibility="invisible"
                tools:text="10-21 14:30  开 67000  高 67500  低 66000  收 67231  量 1.2K" />
        </FrameLayout>
    </LinearLayout>

    <!-- K 线图：占满剩余全部高度 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bitdash.app.CandleChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/loading"
            android:textColor="@color/text_dim"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
