<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingBottom="12dp">

    <!-- 顶部标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择监控币种"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelCoinPicker"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@android:string/cancel"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- 搜索输入框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etSearchCoin"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_input_box"
            android:hint="🔍 快速搜索币种（如 BTC / SOL / ETH）"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- 币种列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="220dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCoinPicker"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvCoinPickerEmpty"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="center"
            android:text="未找到匹配的币种"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
